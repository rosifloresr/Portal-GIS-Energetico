# Copiá este archivo como .env y completá los valores. Nunca subas el .env.

# "production" activa cookies Secure, exige SECRET_KEY y oculta /docs.
ENVIRONMENT=development

# Firma los tokens de sesión. Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# SQLite no requiere instalar nada. Para PostgreSQL/PostGIS:
#   postgresql+psycopg2://gis_user:TU_PASSWORD@localhost:5432/bd_activos_energia
DATABASE_URL=sqlite:///./gis.db

# Orígenes del frontend autorizados por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Solo los usa el script seed_admin. Si ADMIN_PASSWORD queda vacía,
# el script genera una contraseña aleatoria y la muestra una vez.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
